{
  "name": "@bigmistqke/whiteboard",
  "version": "0.12.0",
  "description": "A whiteboard for you and your agent: it writes markdown pages you read live in the browser, you answer through forms it waits on",
  "keywords": [
    "agent",
    "ai",
    "markdown",
    "live-reload",
    "forms",
    "whiteboard",
    "agent-skills",
    "skill",
    "cli"
  ],
  "license": "MIT",
  "author": "bigmistqke",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigmistqke/whiteboard.git"
  },
  "homepage": "https://github.com/bigmistqke/whiteboard#readme",
  "bugs": "https://github.com/bigmistqke/whiteboard/issues",
  "type": "module",
  "bin": {
    "whiteboard": "dist/bin/whiteboard.js"
  },
  "exports": {
    ".": {
      "source": "./src/define.ts",
      "types": "./src/define.ts",
      "default": "./dist/define.js"
    },
    "./log": {
      "source": "./src/events.ts",
      "types": "./src/events.ts",
      "default": "./dist/src/events.js"
    },
    "./terminal": {
      "source": "./plugins/terminal/index.ts",
      "types": "./plugins/terminal/index.ts",
      "default": "./dist/plugins/terminal/index.js"
    },
    "./claude-code": {
      "source": "./plugins/claude-code/index.ts",
      "types": "./plugins/claude-code/index.ts",
      "default": "./dist/plugins/claude-code/index.js"
    },
    "./comments": {
      "source": "./plugins/comments/index.ts",
      "types": "./plugins/comments/index.ts",
      "default": "./dist/plugins/comments/index.js"
    },
    "./toc": {
      "source": "./plugins/toc/index.ts",
      "types": "./plugins/toc/index.ts",
      "default": "./dist/plugins/toc/index.js"
    },
    "./solid": {
      "types": "./solid/index.tsx",
      "default": "./dist/solid/index.js"
    },
    "./plugins": {
      "source": "./plugins/index.ts",
      "types": "./plugins/index.ts",
      "default": "./dist/plugins/index.js"
    },
    "./code": {
      "source": "./plugins/code/index.ts",
      "types": "./plugins/code/index.ts",
      "default": "./dist/plugins/code/index.js"
    }
  },
  "files": [
    "bin",
    "src",
    "dist",
    "plugins",
    "solid",
    "skills",
    "!**/*.test.ts"
  ],
  "scripts": {
    "build": "node build.ts",
    "dev": "node build.ts --watch",
    "prepare": "node build.ts",
    "prepublishOnly": "npm run check && npm test",
    "release": "npm run check && npm test && bumpp --commit 'Release v%s' && npm publish --access public",
    "start": "node bin/whiteboard.ts serve",
    "check": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "test": "node --test --test-force-exit 'src/**/*.test.ts' 'plugins/**/*.test.ts'",
    "test:browser": "node --test --test-force-exit --test-concurrency=1 'test/browser/*.test.ts'"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "mdast-util-to-string": "^4.0.0",
    "pele": "^1.13.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.21",
    "solid-js": "^2.0.0-rc.21"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    },
    "@solidjs/web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solidjs/compiler": "^2.0.0-rc.21",
    "@solidjs/web": "^2.0.0-rc.21",
    "@types/node": "^26.6.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bumpp": "^12.3.0",
    "morphdom": "^2.7.7",
    "playwright": "^1.60.0",
    "prettier": "^3.10.1",
    "rolldown": "^1.2.19",
    "solid-js": "^2.0.0-rc.21",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
