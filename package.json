{
  "name": "@bigmistqke/whiteboard",
  "version": "0.1.0",
  "description": "A whiteboard for you and your agent: it writes markdown pages you read live in the browser, you answer through forms it waits on",
  "keywords": [
    "agent",
    "ai",
    "markdown",
    "live-reload",
    "forms",
    "whiteboard",
    "agent-skills",
    "skill",
    "cli"
  ],
  "license": "MIT",
  "author": "bigmistqke",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigmistqke/whiteboard.git"
  },
  "homepage": "https://github.com/bigmistqke/whiteboard#readme",
  "bugs": "https://github.com/bigmistqke/whiteboard/issues",
  "type": "module",
  "bin": {
    "whiteboard": "bin/whiteboard.js"
  },
  "exports": {
    "./config": {
      "types": "./src/define.ts",
      "default": "./dist/define.js"
    },
    "./template": {
      "types": "./markboard/types.ts",
      "default": "./dist/markboard/types.js"
    },
    "./client": {
      "types": "./src/define.ts"
    },
    "./markboard": {
      "types": "./markboard/index.ts",
      "default": "./dist/markboard/index.js"
    },
    "./terminal": {
      "default": "./terminal/index.js"
    },
    "./claude-code": {
      "default": "./claude-code/index.js"
    },
    "./comments": {
      "default": "./comments/index.js"
    },
    "./solid": {
      "types": "./solid/index.tsx",
      "default": "./dist/solid/index.js"
    }
  },
  "files": [
    "bin",
    "src",
    "dist",
    "markboard",
    "solid",
    "terminal",
    "claude-code",
    "comments",
    "skills"
  ],
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "prepare": "node build.js",
    "start": "node bin/whiteboard.js serve",
    "types": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "mdast-util-to-string": "^4.0.0",
    "pele": "^1.13.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.21",
    "solid-js": "^2.0.0-rc.21"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    },
    "@solidjs/web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solidjs/compiler": "^2.0.0-rc.21",
    "@solidjs/web": "^2.0.0-rc.21",
    "@types/node": "^26.6.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "morphdom": "^2.7.7",
    "rolldown": "^1.2.19",
    "solid-js": "^2.0.0-rc.21",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
