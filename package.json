    "pele": "^1.13.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "solid-js": "^2.0.0-rc.21",
    "unified": "^11.0.5",
    "vite": "^8.3.8"
